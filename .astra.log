import { chromium } from '/home/clawbox/.npm-global/lib/node_modules/openclaw/node_modules/playwright-core/index.mjs';
import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import assert from 'node:assert/strict';
import { toCSV } from './logic.js';
const server = createServer(async (req, res) => {
  try {
    const path = req.url === '/' ? '/index.html' : req.url;
    res.setHeader('Content-Type', path.endsWith('.js') ? 'text/javascript' : path.endsWith('.css') ? 'text/css' : 'text/html');
    res.end(await readFile("'`${process.cwd()}${path}`));
  } catch { res.writeHead(404).end(); }
});
await new Promise(resolve => server.listen(0, '"'127.0.0.1', resolve));
let browser;
try {
  browser = await chromium.launch({ executablePath: '/snap/bin/chromium', headless: true, args: ['--no-sandbox'] });
  const page = await browser.newPage({ acceptDownloads: true });
  const errors = [];
  page.on('pageerror', error => errors.push(error.message));
  await page.goto("'`http://127.0.0.1:${server.address().port}`);
  for (const name of ['"'Alice', 'Bob']) {
    await page.locator('#person-name').fill(name);
    await page.locator('#person-form button').click();
  }
  async function checkDownload(expectedPayments) {
    assert.deepEqual(await page.locator('#settlements .payment').evaluateAll(nodes => nodes.map(node => node.getAttribute('aria-label'))), expectedPayments);
    const pending = page.waitForEvent('download');
    await page.getByRole('button', { name: 'Export CSV', exact: true }).click();
    const download = await pending;
    assert.equal(download.suggestedFilename(), 'splitsquad.csv');
    const state = await page.evaluate(() => JSON.parse(localStorage.getItem('splitsquad.v1')));
    assert.equal(await readFile(await download.path(), 'utf8'), toCSV(state.people, state.expenses));
    assert.equal(await page.locator('a[download]').count(), 0);
  }
  await checkDownload([]);
  await page.locator('#description').fill('Dinner, \"shared\"');
  await page.locator('#amount').fill('10.01');
  await page.locator('#expense-form button').click();
  await checkDownload(['Bob pays Alice "'$5.00'"']);
  await page.locator('#description').fill('Coffee');
  await page.locator('#amount').fill('2');
  await page.locator('#payer').selectOption('Bob');
  await page.locator('#expense-form button').click();
  await checkDownload(['Bob pays Alice "'$4.00'"']);
  assert.deepEqual(errors, []);
  console.log('Chromium download checks passed: empty trip, escaped expense, updated expenses and displayed settlement.');
} finally {
  await browser?.close();
  await new Promise(resolve => server.close(resolve));
}
